# Copy to .env (make init does this and fills secrets).
# Do not commit .env.

# Host user that owns ./data (match `id -u` / `id -g`)
HERMES_UID=1000
HERMES_GID=1000

# Bind address for published ports. Use a LAN IP to skip VPNs / extra NICs.
HERMES_BIND_IP=0.0.0.0

# Dashboard (Hermes Desktop remote gateway)
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me

# OpenAI-compatible API
API_SERVER_PORT=8642
API_SERVER_KEY=change-me
API_SERVER_CORS_ORIGINS=*

# Community WebUI (https://github.com/nesquena/hermes-webui) — port 8787
# Password defaults to HERMES_DASHBOARD_BASIC_AUTH_PASSWORD if unset.
HERMES_WEBUI_PORT=8787
# HERMES_WEBUI_PASSWORD=

# Container resource caps
HERMES_MEM_LIMIT=4g
HERMES_CPUS=2.0
HERMES_WEBUI_MEM_LIMIT=1g
HERMES_WEBUI_CPUS=1.0
HERMES_STT_MEM_LIMIT=2g
HERMES_STT_CPUS=2.0
